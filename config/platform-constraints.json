{
  "version": 1,
  "limits": {
    "buildBudgetUsd": 50,
    "monthlyRunCapUsd": 50,
    "launchDeadlineWeeks": 4,
    "minimumMonthlyMarginUsd": "unknown",
    "agentSpend": { "unit": "usd", "perRunUsd": 3, "perMonthUsd": 20 }
  },
  "hosting": {
    "preferredProvider": "aws",
    "candidateProviders": ["aws", "cloudflare", "vercel", "fly-io", "render", "supabase"],
    "allowedProviders": "any",
    "productionGradeRequired": true
  },
  "architecture": {
    "preferSingleDeployable": true,
    "maxDeployableUnitsWithoutJustification": 2,
    "forbiddenUnlessJustified": ["kubernetes", "microservices", "multi-region"]
  },
  "productTypes": {
    "allowed": ["api", "web", "mobile"],
    "preferenceOrder": ["api", "web", "mobile"]
  },
  "excludedDomains": "unknown",
  "notes": "Owner-agreed limits (2026-11-13): build budget and monthly run cap of 50 USD each, launch within 4 weeks, API first. Agent model and search spend is a separate allowance: 3 USD per run and 20 USD per month. Mobile is allowed but ranked last: store fees may not fit the budget."
}
