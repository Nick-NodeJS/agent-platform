{
  "name": "agent-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.9.0",
  "engines": {
    "node": "22.12.0",
    "pnpm": "9.9.0"
  },
  "scripts": {
    "infra:up": "docker compose --project-directory . -f infra/compose.yaml up -d --wait",
    "infra:down": "docker compose --project-directory . -f infra/compose.yaml down",
    "infra:logs": "docker compose --project-directory . -f infra/compose.yaml logs -f",
    "db:migrate": "node apps/cli/dist/main.js migrate",
    "worker:start": "node apps/worker/dist/main.js",
    "cli": "node apps/cli/dist/main.js",
    "doctor": "node apps/cli/dist/main.js doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tests/tsconfig.json",
    "build": "tsc -b",
    "test": "tsc -b && vitest run",
    "smoke": "node scripts/smoke.mjs",
    "test:integration": "tsc -b && vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@platform/contracts": "workspace:^",
    "@platform/integrations": "workspace:^",
    "@platform/persistence": "workspace:^",
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@types/node": "22",
    "@types/pg": "^8.23.1",
    "eslint": "9",
    "pg": "^8.13.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
