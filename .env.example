# Copy to .env (git-ignored). Dummy development values only; never commit real credentials.
EXECUTION_MODE=mock

# Postgres (matches infra/compose.yaml defaults; host port 5433 avoids clashing with a local 5432)
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_dev_password
POSTGRES_DB=platform
POSTGRES_PORT=5433
DATABASE_URL=postgres://platform:platform_dev_password@127.0.0.1:5433/platform

# Temporal dev server
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TASK_QUEUE=agent-platform

# Local task adapter output (git-ignored)
TASK_STORE_DIR=.task-data/tasks
LOG_LEVEL=info

# Only needed when EXECUTION_MODE=openhands (not implemented in milestone 1)
OPENHANDS_AGENT_SERVER_URL=
OPENHANDS_SESSION_API_KEY=

# Human approval verification (PUBLIC keys only). Generate with: pnpm cli approval-keygen --actor <name>
# The PRIVATE signer file is used only by the human CLI (default ~/.config/agent-platform/approval/signer.json,
# or APPROVAL_SIGNER_FILE exported in the approver's own shell). Never put it in this shared .env or the worker environment.
APPROVAL_TRUSTED_SIGNERS_FILE=

# Agent execution lease (ms); renewed while an Activity runs
AGENT_LEASE_TTL_MS=120000

# Model provider credentials, referenced by NAME from model profiles. Leave empty.
PROVIDER_API_KEY_PLACEHOLDER=
